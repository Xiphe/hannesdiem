{
  "name": "hannesdiem",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "media:build": "node scripts/build-media.ts && node scripts/build-og.ts",
    "media:upload": "node scripts/upload-media.ts",
    "precmx:compile": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const dir of ['.cmx/bundle', '.cmx/documents']) rmSync(dir, { recursive: true, force: true })\"",
    "cmx:compile": "node scripts/compile-cmx.ts",
    "cmx:render": "cmx-document render .cmx/bundle --out-dir .cmx/documents",
    "cmx:environment": "cmx-environment generate .cmx/environment.ts --config cmx.config.ts",
    "cmx:build": "npm run cmx:compile && npm run cmx:render && npm run cmx:environment && node scripts/build-routes.ts",
    "build:app": "npm run cmx:build && node scripts/build.ts",
    "build": "npm run cmx:build && npm run media:build && node scripts/build.ts",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node --import remix/node-tsx --test tests/*.test.ts && playwright test",
    "check": "npm run format:check && npm run typecheck && npm test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cmx-tools/contracts": "0.2.0",
    "@cmx-tools/remix": "0.1.0",
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@cmx-tools/bundle": "0.1.1",
    "@cmx-tools/cli": "0.1.1",
    "@cmx-tools/document": "0.2.0",
    "@cmx-tools/environment": "0.1.1",
    "@hannesdiem/content-components": "file:content/contract",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "prettier": "3.9.10",
    "rolldown": "1.2.14",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  }
}
