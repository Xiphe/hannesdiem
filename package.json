{
  "name": "hannesdiem",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "node --import remix/node-tsx --test tests/server.test.ts && playwright test",
    "check": "npm run build && npm run typecheck && npm test && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "remix": "3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  }
}
