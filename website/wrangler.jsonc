{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hannesdiem",
  "main": "app/worker.ts",
  "build": {
    "command": "node dev.ts",
    "watch_dir": ["../content", "app", "build", "cmx.config.ts", "../contracts", "../dev.ts"],
  },
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "exports": {
    "NewsletterState": { "type": "durable-object", "storage": "sqlite" },
    "ContentState": { "type": "durable-object", "storage": "sqlite" },
  },
  "vars": { "CMX_PUBLISH_PUBLIC_KEYS": "{}" },
  "durable_objects": {
    "bindings": [
      { "name": "NEWSLETTER_STATE", "class_name": "NewsletterState" },
      { "name": "CONTENT_STATE", "class_name": "ContentState" },
    ],
  },
  "preview_urls": false,
  "assets": { "directory": "../dist" },
  "cache": { "enabled": true },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
